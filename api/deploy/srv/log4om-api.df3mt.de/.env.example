POSTGRES_DB=log4om_platform
POSTGRES_USER=log4om
POSTGRES_PASSWORD=change-me-strong-db-password

# >= 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# 32 hex chars (16 bytes) or any long passphrase used as AES key material
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Browser Origin(s). "*" is fine while JWT uses Authorization header (no cookies).
CORS_ORIGIN=*
