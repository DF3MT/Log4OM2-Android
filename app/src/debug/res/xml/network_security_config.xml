<?xml version="1.0" encoding="utf-8"?>
<!-- Debug installs talk to the LAN API over HTTP, including raw IP addresses.
     Domain rules do not reliably match IP literals, so cleartext is allowed here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
